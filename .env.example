# ─── Base de données ──────────────────────────────────────────────────────────
# Chemin vers la SQLite dans le volume Docker nommé (ne pas modifier)
DATABASE_URL=file:/data/dev.db

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=REMPLACER_PAR_UN_SECRET_DE_32_CARACTERES_MINIMUM

# URL publique de l'application
BETTER_AUTH_URL=https://votre-domaine.com

# Origines autorisées (séparées par des virgules)
BETTER_AUTH_TRUSTED_ORIGINS=https://votre-domaine.com,http://localhost:5173

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Port exposé sur l'hôte par le proxy Nginx Docker (doit correspondre à la config nginx système)
INTERNAL_PORT=8083
