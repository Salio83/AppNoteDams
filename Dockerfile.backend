# ─── Stage 1 : Build du frontend React/Vite ───────────────────────────────────
FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ─── Stage 2 : Backend de production ──────────────────────────────────────────
FROM node:20-alpine AS backend

WORKDIR /app

# Dépendances système requises par Prisma
RUN apk add --no-cache openssl

# Installation des dépendances Node (prod + dev pour prisma generate)
COPY package*.json ./
RUN npm ci

# Schéma et migrations Prisma (intégrés dans l'image, pas en bind-mount)
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma/migrations    ./prisma/migrations

# Génération du client Prisma
RUN npx prisma generate

# Nettoyage des devDependencies
RUN npm prune --omit=dev

# Code du serveur
COPY server/      ./server/
COPY src/shared/services/auth.js ./src/shared/services/auth.js
COPY config/ue.json ./config/ue.json

# Frontend buildé depuis le stage 1
COPY --from=frontend-build /app/dist ./dist

# Script de démarrage
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh

EXPOSE 3000

CMD ["./docker-entrypoint.sh"]
